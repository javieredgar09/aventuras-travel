# Archivo de ejemplo de variables de ambiente
# Duplicar este archivo como .env y llenar con valores reales
# NO SUBIR .env A GIT (agregar a .gitignore)

# ===== AMBIENTE =====
APP_ENV=production
APP_DEBUG=false
APP_URL=https://aventurastravelpucallpa.com
APP_NAME=Aventuras Travel

# ===== BASE DE DATOS =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u850459552_aventuraspcl
DB_USER=u850459552_aventuraspcl
DB_PASS=Arejade2409.

# ===== API KEYS =====
# SerpAPI para búsqueda de vuelos/hoteles
SERPAPI_KEY=544a43ee854dfa60b1d14779cdc6f9e58f0ff02831d3ad21f11dd35dc019260b

# ===== EMAIL (SMTP) =====
# Configurar según tu proveedor de email
MAIL_DRIVER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=tu_email@aventurastravelpucallpa.com
MAIL_PASSWORD=tu_contraseña_email
MAIL_FROM_ADDRESS=info@aventurastravelpucallpa.com
MAIL_FROM_NAME=Aventuras Travel

# ===== WHATSAPP =====
# Si usas WhatsApp API
WHATSAPP_API_KEY=tu_api_key
WHATSAPP_PHONE_ID=tu_phone_id
WHATSAPP_BUSINESS_ACCOUNT_ID=tu_account_id

# ===== TIMEZONE =====
TIMEZONE=America/Lima

# ===== SEGURIDAD =====
# Cambiar valores por defecto
APP_KEY=your-secret-key-here-change-me
SESSION_SECRET=your-session-secret-here
